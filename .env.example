# Application Environment (development | production)
# In development, enquiries are dispatched to TEST_EMAIL
# In production, enquiries are dispatched to COMPANY_EMAIL
NODE_ENV=development
PORT=5000

# Email Routing Configuration
TEST_EMAIL=logeshwaranm180@gmail.com
COMPANY_EMAIL=luxonixstacks@gmail.com

# SMTP Server Configuration (Required for live production delivery)
# Examples:
# For Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-digit-app-password
#
# For SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

